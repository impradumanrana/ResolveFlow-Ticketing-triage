# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
app/data/

# Environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# Build artifacts
build/
dist/
*.egg-info/

# Browser-automation scratch output. Screenshots you intend to ship
# (docs/, README assets) are deliberately NOT ignored.
.playwright-mcp/

# Terraform (C02). Only *.example files are committed.
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions
# and checksums, which is a supply-chain control worth reviewing in a diff.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
backend.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
