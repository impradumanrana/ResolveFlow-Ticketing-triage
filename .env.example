# Local-only internal service credential. Generate a unique value; never use
# this placeholder outside local development.
RESOLVEFLOW_INTERNAL_API_TOKEN=replace_with_a_long_random_local_token
DEPLOYMENT_PROFILE=local
AI_API_BASE_URL=http://127.0.0.1:8080

# --- Identity and access (C03) ------------------------------------------
# In a deployed environment every value below comes from Secret Manager and
# the Cloud Run configuration defined in infra/terraform. These are for local
# development only.

# Session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_long_random_local_value

# Public origin. http:// here relaxes the __Secure- cookie prefix so sign-in
# works over plain HTTP locally. Anything else is treated as HTTPS.
AUTH_URL=http://localhost:3000

# Google Workspace OAuth client for *login only*.
# Redirect URI: http://localhost:3000/api/auth/callback/google
# Mailbox scopes are requested separately in C06 and are never bundled here.
GOOGLE_OAUTH_CLIENT_ID=replace_with_the_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_the_oauth_client_secret

# Salt for hashing source addresses in audit events. A distinct value per
# environment, so hashes cannot be correlated across them.
AUDIT_IP_SALT=replace_with_a_long_random_local_value

# Local PostgreSQL. Deployed environments use DB_INSTANCE_CONNECTION_NAME,
# DB_NAME, and DB_IAM_USER with IAM authentication and no password.
DATABASE_URL=postgresql://resolveflow:resolveflow@127.0.0.1:5432/resolveflow

# --- Gmail mailbox connection (C06) -------------------------------------
# A separate OAuth client from sign-in, so the restricted gmail.readonly scope
# never sits on the client every staff member signs in through. Create it as an
# *Internal* app in the client's Workspace organization; see
# docs/MAILBOX_CONNECTION_MODES.md. Leave these empty and mailbox connection
# answers 503 rather than doing anything unsafe.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/mailboxes/oauth/callback

# Which scopes consent asks for: read_only (default) or read_and_draft.
# read_and_draft adds gmail.compose so an approved answer can become a draft in
# the client's mailbox. It needs the client's authorization, the scope added to
# their OAuth consent screen, migration 20260918_0010 applied, and the mailbox
# reconnected - see "Turning drafting on" in docs/MAILBOX_CONNECTION_MODES.md.
# Anything unrecognised here is treated as read_only.
RESOLVEFLOW_MAILBOX_SCOPES=read_only

# Keyring for sealing mailbox refresh tokens: key-id:base64-32-bytes[,more...]
# The first entry is active; later entries stay readable for rotation.
# Generate one with: printf 'local-1:%s' "$(openssl rand -base64 32)"
MAILBOX_TOKEN_ENCRYPTION_KEY=

OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Optional. Defaults to app/data/qdrant beside the SQLite knowledge database.
# QDRANT_PATH=app/data/qdrant
QDRANT_COLLECTION=resolveflow_knowledge
KB_THRESHOLD=0.55
